# ProjectX / TopstepX credentials. Keep these on the user's personal device.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_API_URL=https://api.topstepx.com
PROJECTX_USER_HUB_URL=https://rtc.topstepx.com/hubs/user
PROJECTX_MARKET_HUB_URL=https://rtc.topstepx.com/hubs/market

# Explicit Glitch scope. The model never chooses these identifiers.
GLITCH_ACCOUNT_ID=
GLITCH_ACCOUNT_NAME=
GLITCH_CONTRACT_ID=
GLITCH_INSTRUMENT=MNQ
GLITCH_LIVE_MARKET_DATA=false

# Local authenticated bridge used by Hermes or another bounded decision worker.
GLITCH_LOCAL_TOKEN=
GLITCH_LOCAL_HOST=127.0.0.1
GLITCH_LOCAL_PORT=8790

# disabled: no intent execution
# shadow: validate and journal intents, but never call Order/place
# armed: permit validated execution after every deterministic guard passes
GLITCH_TRADING_MODE=shadow
# Required exact acknowledgement before armed mode can start. Leave blank during scaffolding.
GLITCH_ARMED_ACK=
GLITCH_REQUIRE_SIMULATED=true
GLITCH_ENTRY_WINDOW_OPEN=false

# Topstep account model. Values must be reconciled from the account purchase and dashboard.
GLITCH_PROGRAM=xfa
GLITCH_ACCOUNT_SIZE=50000
GLITCH_INITIAL_MAX_LOSS=2000
GLITCH_HIGHEST_EOD_BALANCE=0
GLITCH_MLL_LOCKED_AT_ZERO=false
GLITCH_PAYOUT_PROCESSED=false

# Conservative internal risk controls. These are deliberately tighter than firm liquidation limits.
GLITCH_MAX_RISK_FRACTION_OF_BUFFER=0.04
GLITCH_MAX_DAILY_RISK_USD=200
GLITCH_DAILY_REALIZED_PNL_USD=0
GLITCH_ESTIMATED_ROUND_TURN_FEES_USD=2.50
GLITCH_SLIPPAGE_RESERVE_TICKS=2
GLITCH_MAX_QUOTE_AGE_MS=5000
GLITCH_MAX_INTENT_AGE_MS=60000
GLITCH_PACKET_LEASE_MS=60000
GLITCH_MAX_STATE_AGE_MS=5000
GLITCH_RECONCILE_INTERVAL_MS=3000
GLITCH_MAX_CONTRACTS=1

# Local event ledger.
GLITCH_DATA_DIR=./data
