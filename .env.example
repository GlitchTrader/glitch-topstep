# Shared with Hermes profile glitch-topstep
GLITCH_TOPSTEP_LOCAL_TOKEN=replace-with-shared-local-token
GLITCH_TOPSTEP_PORT=8790
GLITCH_TOPSTEP_HOST=127.0.0.1
GLITCH_TOPSTEP_TRADING_MODE=shadow

# Instrument selection when PROJECT_X_CONTRACT_ID is empty
GLITCH_TOPSTEP_INSTRUMENT=MNQ
GLITCH_TOPSTEP_ACCOUNT_SIZE=50000
GLITCH_TOPSTEP_ALLOWED_RISK_USD=50
GLITCH_TOPSTEP_MAX_CONTRACTS=5
GLITCH_TOPSTEP_INITIAL_MAX_LOSS=2000
GLITCH_TOPSTEP_DAILY_LOSS_LIMIT_USD=1000
GLITCH_TOPSTEP_SESSION_HISTORY_HOURS=8

# Enriched packet bars
GLITCH_TOPSTEP_BARS_1M_LIMIT=60
GLITCH_TOPSTEP_BARS_5M_LIMIT=12
GLITCH_TOPSTEP_BARS_15S_LIMIT=80
GLITCH_TOPSTEP_MICRO_BARS_ENABLED=true
GLITCH_TOPSTEP_MICRO_BARS_ALWAYS=false
GLITCH_TOPSTEP_MICRO_BARS_RTH_ONLY=true
GLITCH_TOPSTEP_MICRO_BARS_EXTREME_THRESHOLD=0.85

# Realtime SignalR (Phase C)
GLITCH_TOPSTEP_REALTIME_ENABLED=true
GLITCH_TOPSTEP_REALTIME_TAPE_LIMIT=40
GLITCH_TOPSTEP_REALTIME_DEPTH_LIMIT=10
GLITCH_TOPSTEP_CORRELATION_SYMBOL=ES
GLITCH_TOPSTEP_OUTCOMES_PATH=C:\Users\arifr\AppData\Local\hermes\profiles\glitch-topstep\state\outcomes.jsonl
PROJECT_X_RTC_MARKET_URL=https://rtc.topstepx.com/hubs/market
PROJECT_X_RTC_USER_URL=https://rtc.topstepx.com/hubs/user

# ProjectX / TopstepX credentials (https://gateway.docs.projectx.com/docs/getting-started/authenticate/authenticate-api-key)
PROJECT_X_API_URL=https://api.topstepx.com
PROJECT_X_USERNAME=
PROJECT_X_API_KEY=
# Optional: store secrets in separate UTF-8 files to avoid .env parsing issues
# PROJECT_X_USERNAME_FILE=C:\\secrets\\topstep-username.txt
# PROJECT_X_API_KEY_FILE=C:\\secrets\\topstep-api-key.txt

# Optional overrides
PROJECT_X_ACCOUNT_ID=
PROJECT_X_CONTRACT_ID=
PROJECT_X_LIVE_DATA=false
