# ProjectX / TopstepX credentials. Keep these on the user's personal device.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_API_URL=https://api.topstepx.com
PROJECTX_USER_HUB_URL=https://rtc.topstepx.com/hubs/user
PROJECTX_MARKET_HUB_URL=https://rtc.topstepx.com/hubs/market

# Explicit local venue scope. Hermes receives aliases, never these provider identifiers.
GLITCH_ACCOUNT_ID=
GLITCH_ACCOUNT_NAME=
GLITCH_CONTRACT_ID=
GLITCH_INSTRUMENT=
GLITCH_LIVE_MARKET_DATA=false

# Local authenticated bridge used by the dedicated Hermes profile.
GLITCH_LOCAL_TOKEN=
GLITCH_LOCAL_HOST=127.0.0.1
GLITCH_LOCAL_PORT=8790

# disabled: reject executable intents because the human operator disabled execution
# shadow: verify and journal intents without calling ProjectX order mutations
# armed: permit factually valid order mutations after explicit operator acknowledgement
GLITCH_TRADING_MODE=shadow
GLITCH_ARMED_ACK=

# Topstep account facts. These are evidence and hard venue/account boundaries, not a strategy.
GLITCH_ACCOUNT_STAGE=unknown
GLITCH_LOSS_MODEL=express_funded_eod
GLITCH_POLICY_AUTHORITY=operator_configured
GLITCH_POLICY_VERIFIED_AT_UTC=
GLITCH_STARTING_BALANCE=50000
GLITCH_INITIAL_MAXIMUM_LOSS=2000
GLITCH_HIGHEST_EOD_BALANCE=0
GLITCH_LOSS_FLOOR_LOCKED_AT_ZERO=false
GLITCH_PAYOUT_PROCESSED=false
GLITCH_HARD_LOSS_FLOOR_USD=
GLITCH_MAX_CONTRACTS=1

# Execution calculations. Fee and slippage reserves are applied per contract.
GLITCH_ESTIMATED_ROUND_TURN_FEES_USD=2.50
GLITCH_SLIPPAGE_RESERVE_TICKS=2
GLITCH_MAX_QUOTE_AGE_MS=5000
GLITCH_MAX_STATE_AGE_MS=5000
# Maximum age of a Hermes decision at intake, measured from intent.created_utc.
# Entry intents older than this are rejected as intent_stale. This is decision
# expiry only; it never authorizes resubmitting or terminalizing a live intent.
GLITCH_MAX_INTENT_AGE_MS=300000
GLITCH_PACKET_LEASE_MS=300000
GLITCH_RECONCILE_INTERVAL_MS=3000

# Provider evidence. Execution identity uses FULL SQLite durability in glitch-topstep.sqlite.
# High-frequency ProjectX market telemetry uses a separate WAL/NORMAL database and bounded retention.
# REST, lifecycle, account, order, position, and user-trade evidence is not pruned by these settings.
GLITCH_PROVIDER_MARKET_EVENT_RETENTION=500000
GLITCH_PROVIDER_MARKET_PRUNE_INTERVAL=10000

# Durable ProjectX order/trade history continuity.
# The overlap rechecks corrections, voids, and late provider updates without duplicating unchanged evidence.
GLITCH_PROVIDER_HISTORY_INITIAL_LOOKBACK_HOURS=168
GLITCH_PROVIDER_HISTORY_OVERLAP_MINUTES=1440
GLITCH_PROVIDER_HISTORY_WINDOW_MINUTES=1440
GLITCH_PROVIDER_HISTORY_SYNC_INTERVAL_MS=60000

# Local append-only evidence.
GLITCH_DATA_DIR=./data
